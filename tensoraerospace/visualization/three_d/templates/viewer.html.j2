<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ title|default('F-16 flight viewer') }}</title>
<style>
{{ css }}
</style>
</head>
<body>
<div id="scene"></div>
<div id="hud">
    <div><span class="label">t</span><span id="hud-time" class="value">0.00 s</span></div>
    <div><span class="label">α</span><span id="hud-alpha" class="value">0.00°</span></div>
    <div><span class="label">β</span><span id="hud-beta" class="value">0.00°</span></div>
    <div><span class="label">ωx</span><span id="hud-wx" class="value">0.00°/s</span></div>
    <div><span class="label">ωz</span><span id="hud-wz" class="value">0.00°/s</span></div>
    <div><span class="label">stab</span><span id="hud-stab" class="value">0.0°</span></div>
    <div><span class="label">ail</span><span id="hud-ail" class="value">0.0°</span></div>
    <div><span class="label">dir</span><span id="hud-dir" class="value">0.0°</span></div>
    <div><span class="label">events</span><span id="hud-events" class="value">—</span></div>
</div>
<div id="keyboard-help" style="display:none;">
    <div class="kbd-title">Keyboard shortcuts</div>
    <div><kbd>Space</kbd> play / pause</div>
    <div><kbd>←</kbd> <kbd>→</kbd> scrub ±0.5 s</div>
    <div><kbd>Shift</kbd>+<kbd>←</kbd>/<kbd>→</kbd> scrub ±5 s</div>
    <div><kbd>Home</kbd> / <kbd>End</kbd> jump to start / end</div>
    <div><kbd>1</kbd> 3D · <kbd>2</kbd> top · <kbd>3</kbd> left · <kbd>4</kbd> right</div>
    <div><kbd>+</kbd> <kbd>-</kbd> speed up / down</div>
    <div><kbd>H</kbd> toggle this help</div>
</div>
<div id="controls">
    <button id="btn-play">Pause</button>
    <input id="timeline" type="range" min="0" max="100" value="0">
    <button id="btn-cam-3d">3D Camera</button>
    <button id="btn-cam-top">Top-down</button>
    <button id="btn-cam-left">Left side</button>
    <button id="btn-cam-right">Right side</button>
    <span class="speed-label">speed</span>
    <select id="speed">
        <option value="0.25">0.25×</option>
        <option value="0.5">0.5×</option>
        <option value="1" selected>1×</option>
        <option value="2">2×</option>
        <option value="4">4×</option>
    </select>
</div>

<script>
window.FLIGHT_LOG = {{ flight_log_json|safe }};
</script>
<script>
{{ three_js }}
</script>
<script>
{{ orbit_controls_js }}
</script>
<script>
{{ viewer_js }}
</script>
</body>
</html>
